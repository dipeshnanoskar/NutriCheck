# Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-secret

# MongoDB
# Local: mongodb://localhost:27017/nutricheck
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nutricheck
MONGODB_URI=mongodb://localhost:27017/nutricheck

# Open Food Facts (public, no key required) - base URL only, override if self-hosting
OFF_API_BASE=https://world.openfoodfacts.org/api/v2

# CORS - comma separated list of allowed origins for the Flutter web build / admin tools
CORS_ORIGINS=*

# Tesseract binary path (only needed on Windows, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Access token lifetime (minutes) / refresh token lifetime (days)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
